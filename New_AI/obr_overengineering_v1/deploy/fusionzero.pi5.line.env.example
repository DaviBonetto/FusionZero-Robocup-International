# Pi 5 + IMX219 + PCA9685 line-following profile.
# Start with FZ_ROBOT_DRY_RUN=1 and wheels lifted/disconnected.
FZ_PYTHON=
FZ_CAMERA_INDEX=0
FZ_CAMERA_WIDTH=640
FZ_CAMERA_HEIGHT=480
FZ_CAMERA_FPS=25
FZ_CAMERA_BACKEND=picamera2
FZ_CAMERA_ROTATION=0
FZ_REMOTE_BIND=0.0.0.0
FZ_REMOTE_PORT=8765
FZ_REMOTE_STREAM_FPS=5
FZ_REMOTE_JPEG_QUALITY=65
FZ_VISION_CONFIG=New_AI/obr_overengineering_v1/configs/vision_config.json
FZ_PROFILE=line_only
FZ_RECORDINGS_ROOT=
FZ_ROBOT_BACKEND=pca9685
FZ_ROBOT_SERIAL_PORT=
FZ_ROBOT_BAUD=115200
FZ_ROBOT_DRY_RUN=1
FZ_LINE_ONLY=1
FZ_ENABLE_LEDS=1
FZ_LED1_GPIO=18
FZ_LED2_GPIO=23
FZ_PCA9685_I2C_ADDRESS=0x40
FZ_PCA9685_FREQUENCY_HZ=50
FZ_PCA9685_LEFT_CHANNEL=4
FZ_PCA9685_RIGHT_CHANNEL=0
FZ_PCA9685_LEFT_CHANNELS=4,5
FZ_PCA9685_RIGHT_CHANNELS=0,1
FZ_PCA9685_MIN_US=1000
FZ_PCA9685_NEUTRAL_US=1600
FZ_PCA9685_MAX_US=2000
# Legacy symmetric fallback; leave empty when using the calibrated side values.
FZ_PCA9685_BASE_THROTTLE_US=
FZ_PCA9685_LEFT_BASE_THROTTLE_US=300
FZ_PCA9685_RIGHT_BASE_THROTTLE_US=200
FZ_PCA9685_TURN_GAIN_US=220
FZ_PCA9685_PID_KP_US=320
FZ_PCA9685_PID_KI_US=0
FZ_PCA9685_PID_KD_US=12
FZ_PCA9685_PID_INTEGRAL_LIMIT=0.15
FZ_PCA9685_PID_DERIVATIVE_FILTER=0.60
FZ_PCA9685_LINE_HOLD_MS=120
FZ_PCA9685_MAX_OUTPUT_US=240
FZ_PCA9685_LINE_ERROR_DEADBAND=0.025
FZ_PCA9685_GREEN_TURN_US=260
FZ_PCA9685_LEFT_INVERTED=0
FZ_PCA9685_RIGHT_INVERTED=1
# Confirmed from physical response logs: camera/chassis steering is mirrored.
FZ_PCA9685_LINE_STEERING_INVERTED=1
# Closed 90-degree pivot: reverse the inside side through the camera blind spot,
# finish more gently while visible, then suppress an immediate opposite bounce.
FZ_PCA9685_SHARP_CURVE_THRESHOLD=0.55
FZ_PCA9685_SHARP_CURVE_HOLD_MS=900
FZ_PCA9685_SHARP_CURVE_OUTER_SCALE=1.0
FZ_PCA9685_SHARP_CURVE_INNER_REVERSE_SCALE=0.55
FZ_PCA9685_SHARP_CURVE_VISIBLE_COMMIT_MS=2100
FZ_PCA9685_SHARP_CURVE_FINISH_INNER_REVERSE_SCALE=0.35
FZ_PCA9685_SHARP_CURVE_EXIT_SETTLE_MS=320
FZ_PCA9685_SHARP_CURVE_EXIT_THROTTLE_SCALE=1.0
FZ_PCA9685_SHARP_CURVE_EXIT_MAX_CORRECTION_US=0
FZ_PCA9685_SHARP_CURVE_RECOVERY_MS=520
FZ_PCA9685_SHARP_CURVE_RECOVERY_MAX_CORRECTION_US=45
